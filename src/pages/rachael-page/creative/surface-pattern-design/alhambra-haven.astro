---
import SPDCollectionNav from '../../../../components/SPDCollectionNav.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const colourways = [
  { name: 'Purple Blues',  file: 'purple-blues.png'  },
  { name: 'Teal Limes',    file: 'teal-limes.png'    },
  { name: 'Purple Teals',  file: 'purple-teals.png'  },
  { name: 'Neutrals',      file: 'neutrals.png'      },
  { name: 'Bluey Greens',  file: 'bluey-greens.png'  },
];

const mockups = [
  { file: 'Bedding medscale.jpeg',   caption: 'Purple Blues bedding' },
  { file: 'Curtain closeup.jpeg',    caption: 'Purple Blues curtains closeup' },
  { file: 'Cushion.jpeg',            caption: 'Purple Blues cushion' },
  { file: 'Fabric.jpeg',             caption: 'Purple Blues fabric' },
  { file: 'bedroom.jpeg',            caption: 'Bluey Greens bedroom wallpaper' },
  { file: 'chair largescale.jpeg',   caption: 'Purple Blues armchair, large scale' },
  { file: 'duvet.jpeg',              caption: 'Bluey Greens bedroom duvet cover' },
  { file: 'lime-curtains.jpeg',      caption: 'Purple Blues living room curtains' },
  { file: 'chair smallscale neutrals.jpeg', caption: 'Neutrals armchair, small scale' },
];
---


<BaseLayout title="Alhambra Haven — Surface Pattern Collection by Rachael Page" description="Intricate geometry & soothing palettes of traditional Moorish tiling — interlocking stars & kaleidoscopic symmetry. Available for licensing.">

  <!-- COLLECTION HERO -->
  <section class="spd-hero">
    <div class="spd-hero-text">
      <p class="spd-collection-label">Surface Pattern Collection</p>
      <h1 class="spd-collection-name">Alhambra Haven</h1>
      <p class="spd-collection-desc">
        Intricate geometry &amp; soothing palettes of traditional Moorish tiling, bringing the timeless elegance of interlocking stars &amp; kaleidoscopic symmetry.
      </p>
      <div class="spd-meta">
        <span>5 colourways</span>
        <span>Straight repeat</span>
        <span>Wallpaper · Fabric · Ceramics · Home Accessories</span>
      </div>
      <a href="mailto:artfulydesign@gmail.com?subject=Licensing%20enquiry%20—%20Alhambra%20Haven" class="spd-cta">
        Enquire about licensing
      </a>
    </div>
    <div class="spd-hero-image">
      <img src="/images/patterns/alhambra-haven/mockups/duvet.jpeg" alt="Alhambra Haven — Bedding, Teal Limes colourway" />
    </div>
  </section>

  <!-- COLOURWAYS GRID -->
  <section class="spd-colourways">
    <div class="spd-colourways-inner">
      <h2 class="spd-section-label">Patterns, scales &amp; colourways</h2>
      <div class="spd-grid">
        {colourways.map(c => (
          <div class="spd-swatch">
            <img src={`/images/patterns/alhambra-haven/${c.file}`} alt={`Alhambra Haven — ${c.name}`} loading="lazy" />
            <p class="spd-swatch-name">{c.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOCKUPS / IN CONTEXT -->
  <section class="spd-mockups">
    <div class="spd-mockups-inner">
      <h2 class="spd-section-label">In Context</h2>
      <div class="spd-mockups-grid">
        {mockups.map(m => (
          <figure class="spd-mockup-item">
            <img src={`/images/patterns/alhambra-haven/mockups/${m.file}`} alt={m.caption} loading="lazy" />
            <figcaption>{m.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- COLLECTION NAV -->
  <SPDCollectionNav nextSlug="bloomsbury-hounds" nextName="Bloomsbury Hounds" />

  <!-- LICENSING CTA -->
  <section class="spd-licensing">
    <div class="spd-licensing-inner">
      <h2 class="spd-licensing-title">Interested in licensing this collection?</h2>
    </div>
  </section>

</BaseLayout>
