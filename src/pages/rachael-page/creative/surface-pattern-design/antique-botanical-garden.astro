---
import SPDCollectionNav from '../../../../components/SPDCollectionNav.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const colourways = [
  { name: 'Cool Tones', file: 'Herabrium florals 6.png' },
];

const mockups = [
  { file: 'mockups/01-lumbar-pillow-studio.jpeg',        caption: 'Cool Tones lumbar pillow' },
  { file: 'mockups/02-fabric.jpeg',                      caption: 'Cool Tones fabric' },
  { file: 'mockups/03-chair.jpeg',                       caption: 'Cool Tones armchair' },
  { file: 'mockups/04-curtain.jpeg',                     caption: 'Cool Tones living room curtains' },
  { file: 'mockups/05-curtain-closeup.jpeg',             caption: 'Cool Tones curtains closeup' },
  { file: 'mockups/06-fabric-closeup.jpeg',              caption: 'Cool Tones fabric closeup' },
  { file: 'mockups/09-sheet-set-2.jpeg',                 caption: 'Cool Tones sheet set' },
  { file: 'mockups/08-bedding.jpeg',                     caption: 'Cool Tones bedding closeup' },
  { file: 'mockups/07-sheet-set.jpeg',                   caption: 'Cool Tones bedroom sheet set' },
  { file: 'mockups/10-napkins-large.jpeg',               caption: 'Cool Tones napkins' },
  { file: 'mockups/11-napkins.jpeg',                     caption: 'Cool Tones napkins' },
  { file: 'mockups/12-napkins-folded.jpeg',              caption: 'Cool Tones napkins with fork' },
  { file: 'mockups/13-table-runner.jpeg',                caption: 'Cool Tones dining room table runner' },
  { file: 'mockups/14-table-runner-napkins.jpeg',        caption: 'Cool Tones table runner & napkins' },
  { file: 'mockups/15-napkins-with-cutlery.jpeg',        caption: 'Cool Tones napkins with cutlery' },
  { file: 'mockups/16-wallpaper-grasscloth-closeup.jpeg', caption: 'Cool Tones grasscloth wallpaper closeup' },
  { file: 'mockups/18-wallpaper.jpeg',                   caption: 'Cool Tones bedroom wallpaper' },
  { file: 'mockups/17-wallpaper-bedroom-closeup.jpeg',   caption: 'Cool Tones kitchen wallpaper closeup' },
];
---

<BaseLayout title="Antique Botanical Garden — Surface Pattern Collection by Rachael Page" description="A vintage herbarium-inspired botanical pattern with pressed florals, delicate stems and old-world charm. Available for wallpaper, fabric and home accessories licensing.">

  <!-- COLLECTION HERO -->
  <section class="spd-hero">
    <div class="spd-hero-text">
      <p class="spd-collection-label">Surface Pattern Collection</p>
      <h1 class="spd-collection-name">Antique Botanical Garden</h1>
      <p class="spd-collection-desc">
        A vintage herbarium-inspired botanical pattern with pressed florals, delicate stems &amp; old-world charm — drawn in the spirit of a 19th-century field&nbsp;journal.
      </p>
      <div class="spd-meta">
        <span>1 colourway</span>
        <span>Basic repeat</span>
        <span>Wallpaper · Fabric · Home Accessories</span>
      </div>
      <a href="mailto:artfulydesign@gmail.com?subject=Licensing%20enquiry%20—%20Antique%20Botanical%20Garden" class="spd-cta">
        Enquire about licensing
      </a>
    </div>
    <div class="spd-hero-image">
      <img src="/images/patterns/antique-botanical-garden/mockups/01-lumbar-pillow.jpeg" alt="Antique Botanical Garden — botanical fabric on lumbar pillow" />
    </div>
  </section>

  <!-- COLOURWAYS GRID -->
  <section class="spd-colourways">
    <div class="spd-colourways-inner">
      <h2 class="spd-section-label">Patterns, scales &amp; colourways</h2>
      <div class="spd-grid">
        {colourways.map(c => (
          <div class="spd-swatch">
            <img src={`/images/patterns/antique-botanical-garden/${c.file}`} alt={`Antique Botanical Garden — ${c.name}`} loading="lazy" />
            <p class="spd-swatch-name">{c.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MOCKUPS / IN CONTEXT -->
  <section class="spd-mockups">
    <div class="spd-mockups-inner">
      <h2 class="spd-section-label">In Context</h2>
      <div class="spd-mockups-grid">
        {mockups.map(m => (
          <figure class="spd-mockup-item">
            <img src={`/images/patterns/antique-botanical-garden/${m.file}`} alt={m.caption} loading="lazy" />
            <figcaption>{m.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- COLLECTION NAV -->
  <SPDCollectionNav nextSlug="hydrangea-haven" nextName="Hydrangea Haven" />

  <!-- LICENSING CTA -->
  <section class="spd-licensing">
    <div class="spd-licensing-inner">
      <h2 class="spd-licensing-title">Interested in licensing this collection?</h2>
    </div>
  </section>

</BaseLayout>
