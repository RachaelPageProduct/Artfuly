      { name: "Linocut / Woodblock Print", origin: "Global — Printmaking", description: "Bold graphic forms carved and printed — flat areas of colour, visible texture and strong outlines.", img: "/images/ai-art-styles/linocut-woodblock-print.jpg", fallback: "linear-gradient(150deg,#1d1d1d,#8b4010,#e8d8b8)" },
      { name: "Storybook Illustration", origin: "Global — Narrative Art", description: "Warm, whimsical and narrative — textured brushwork, expressive characters and cosy atmospheric scenes.", img: "/images/ai-art-styles/storybook-illustration.jpg", fallback: "linear-gradient(150deg,#7a4a9a,#f4a260,#6ab04c)" },
      { name: "Editorial Illustration", origin: "Global — Publishing Art", description: "Conceptual, graphic and idea-driven — used in magazines and publications to visualise complex themes.", img: "/images/ai-art-styles/editorial-illustration.jpg", fallback: "linear-gradient(150deg,#1d1d1d,#e63946,#f4d03f)" },
      { name: "Comic Book Art", origin: "US & Global, 20th Century–present", description: "Bold outlines, Ben-Day dot shading, dynamic action poses and vivid colour — superhero and graphic novel aesthetic.", img: "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/An_Earth_Man_on_Venus_comic_book.jpg/500px-An_Earth_Man_on_Venus_comic_book.jpg", fallback: "linear-gradient(150deg,#d90429,#ffbe0b,#1565c0)" },
      { name: "Concept Art", origin: "Film & Games Industry, 20th C.–present", description: "Exploratory design for games, film and animation — world-building imagery that balances imagination with plausibility.", img: "/images/ai-art-styles/concept-art.jpg", fallback: "linear-gradient(150deg,#0d253f,#1a9ea0,#3a3a5a)" }
    ]
  },
  {
    title: "Printmaking",
    items: [
      { name: "Etching", origin: "European, 16th Century–present", description: "Fine lines bitten into a metal plate with acid — intricate detail, rich hatching and a distinctive velvety texture.", img: "https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/The_Soldier_and_his_Wife.jpg/500px-The_Soldier_and_his_Wife.jpg", fallback: "linear-gradient(150deg,#3a3020,#7a6a50,#c8b890)" },
      { name: "Engraving", origin: "European, 15th Century–present", description: "Lines cut directly into a metal plate with a burin — precision, tonal range and a formal elegance used for portraits and maps.", img: "https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Gustave_Dor%C3%A9_-_Dante_Alighieri_-_Inferno_-_Plate_9_%28Canto_III_-_Charon%29.jpg/500px-Gustave_Dor%C3%A9_-_Dante_Alighieri_-_Inferno_-_Plate_9_%28Canto_III_-_Charon%29.jpg", fallback: "linear-gradient(150deg,#2a2a2a,#6a5a4a,#aaa090)" },
      { name: "Lithography", origin: "European, Late 18th Century–present", description: "Drawing with greasy crayon on limestone — smooth tonal gradients, a painterly quality and ideal for bold poster work.", img: "https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/%28Albi%29_Le_Divan_japonais_1893_lithographie_-_Toulouse-Lautrec_MTH.A3.jpg/500px-%28Albi%29_Le_Divan_japonais_1893_lithographie_-_Toulouse-Lautrec_MTH.A3.jpg", fallback: "linear-gradient(150deg,#4a3a2a,#8a7a6a,#c8b8a8)" },
      { name: "Screen Print / Silkscreen", origin: "Global, Early 20th Century–present", description: "Flat vibrant colour pushed through a mesh stencil — Pop Art's preferred medium, used by Warhol and modern poster makers.", img: "/images/ai-art-styles/screen-print-silkscreen.jpg", fallback: "linear-gradient(150deg,#e63946,#f4d03f,#1565c0)" },
      { name: "Risograph", origin: "Digital Print, 1980s–present", description: "Layered soy-ink spot colours on paper — deliberate misregistration, grain texture and a distinctive limited-palette indie print aesthetic.", img: "/images/ai-art-styles/risograph.jpg", fallback: "linear-gradient(150deg,#e8a020,#e83060,#20a0c8)" },
      { name: "Mezzotint", origin: "European, 17th–18th Century", description: "Worked from dark to light on a roughened plate — velvety blacks, soft tonal gradations and a painterly, atmospheric quality.", img: "/images/ai-art-styles/mezzotint.jpg", fallback: "linear-gradient(150deg,#1a1a1a,#3a3a3a,#8a7a6a)" }
    ]
  },
