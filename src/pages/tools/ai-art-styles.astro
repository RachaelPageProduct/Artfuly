      { name: "Lomography / Film Photography", origin: "Photography, 1990s–present", description: "Analogue film aesthetics — light leaks, grain, vignettes and saturated colour from toy cameras and expired stock.", img: "/images/ai-art-styles/lomography-film-photography.jpg", fallback: "linear-gradient(150deg,#8a3a00,#c86020,#e8d0a0)" }
