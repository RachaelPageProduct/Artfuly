    title: "Photography & Cinematic",
    items: [
      { name: "Photorealism", origin: "Global, 1960s–present", description: "Indistinguishable from a photograph — accurate lighting, depth of field and surface detail.", img: "https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Steel_life%2C_acrylic_on_canvas%2C_30x36_in.jpg/500px-Steel_life%2C_acrylic_on_canvas%2C_30x36_in.jpg", fallback: "linear-gradient(150deg,#3a3a3a,#7a7a7a,#c8c8c8)" },
      { name: "Film Noir", origin: "Hollywood, 1940s–1950s", description: "High-contrast black and white, dramatic shadows, rain-slick streets and moody 1940s detective atmosphere.", img: "/images/ai-art-styles/film-noir.jpg", fallback: "linear-gradient(150deg,#1a1a1a,#4a4a4a,#8a8a6a)" },
      { name: "Cinematic", origin: "Film — Global", description: "Anamorphic widescreen framing, golden-hour light, shallow depth of field and epic compositional scale.", img: "/images/ai-art-styles/cinematic.jpg", fallback: "linear-gradient(150deg,#1a0a00,#5a3010,#c0a050)" },
