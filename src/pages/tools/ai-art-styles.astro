      { name: "Daguerreotype / Tintype", origin: "Photography, 1839–Late 19th C.", description: "Early photographic processes — sepia tones, shallow depth of field, vignetting and the soft texture of antique silver or iron plates.", img: "https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Portrait_of_a_Daguerreotypist%2C_1845_%28with_Frame%29.jpg/500px-Portrait_of_a_Daguerreotypist%2C_1845_%28with_Frame%29.jpg", fallback: "linear-gradient(150deg,#4a3a20,#8a7a50,#c8b880)" },
