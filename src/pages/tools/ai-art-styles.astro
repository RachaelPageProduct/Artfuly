      { name: "Steampunk", origin: "Sci-fi genre, 1980s–present", description: "Victorian era reimagined with brass gears, steam engines and retro-futurist mechanical contraptions.", img: "/images/ai-art-styles/steampunk.jpg", fallback: "linear-gradient(150deg,#3a1a00,#8b5a00,#c8a060)" },
