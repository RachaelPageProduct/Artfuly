      { name: "Fractal Art", origin: "Digital, 1980s–present", description: "Mathematically generated self-similar patterns at infinite scales — kaleidoscopic, endlessly recursive and alien-organic.", img: "/images/ai-art-styles/fractal-art.jpg", fallback: "linear-gradient(150deg,#000030,#4400aa,#00ccff)" },
