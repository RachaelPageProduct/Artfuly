const featured = [
  ["Watercolour", "Soft and elegant, lovely for weddings, garden parties and wellness events"],
  ["Vector Illustration", "Clean and modern, with plenty of room left for your text"],
  ["Cubism", "Arty and striking, great for gallery and culture events"],
  ["Art Deco", "Gold, geometric and glamorous for galas, New Year and cocktail nights"],
  ["Art Nouveau", "Flowing floral frames for festivals, food and drink, and beauty"],
  ["Swiss / International Style", "Bold grid layouts that suit conferences and talks"],
  ["Bauhaus", "Primary colours and simple shapes for design and architecture events"],
  ["Screen Print / Silkscreen", "That gig poster look, perfect for music nights and markets"],
  ["Risograph", "Grainy, bright and on trend for zines, pop-ups and indie events"],
  ["Pop Art", "Loud, fun and easy to read even at small sizes"],
  ["Memphis Design", "Playful 80s shapes for launches and youth events"],
  ["Vaporwave / Synthwave", "Neon retro vibes for club nights and tech meetups"],
  ["Psychedelic Art", "Swirling colour that suits festivals and music"],
  ["Flat Design", "Simple and friendly, and works really well for social posts"],
  ["Gouache", "Rich matte illustration, the look of modern book covers"],
  ["Linocut / Woodblock Print", "Handmade and crafty, great for makers' markets and food"],
  ["Retrofuturism", "Optimistic 1950s space age style for tech and science events"],
  ["Isometric Illustration", "Ideal for explainers, venue maps and product graphics"],
  ["Kirie (切り絵)", "Layered paper cut look for Christmas and Lunar New Year"],
  ["Minimalism", "Premium and calm for luxury, spa and professional events"]
];
const allItems = groups.flatMap(g => g.items);
groups.unshift({
  title: "Most useful for AI prompts",
  featured: true,
  items: featured.map(([name, bestFor]) => ({ ...allItems.find(i => i.name === name), bestFor }))
});

const app = document.getElementById('app');

groups.forEach(group => {
  const section = document.createElement('section');
  section.className = group.featured ? 'group group-featured' : 'group';

  const header = document.createElement('div');
  header.className = 'group-header';
  header.innerHTML = `
    <div class="group-line"></div>
    <span class="group-title">${group.title}<span class="group-count">${group.items.length}</span></span>
    <div class="group-line"></div>`;
  section.appendChild(header);

  const grid = document.createElement('div');
  grid.className = 'grid';

  group.items.forEach(item => {
    const card = document.createElement('div');
    card.className = 'card';
    const imgHtml = item.img ? `<img src="${item.img}" alt="${item.name}" loading="lazy" onerror="this.style.display='none'">` : '';
    const searchUrl = `https://www.google.com/search?tbm=isch&q=${encodeURIComponent(item.name + ' art style examples')}`;
    card.innerHTML = `
      <div class="card-img">
        <div class="card-img-fallback" style="background:${item.fallback}"></div>
        ${imgHtml}
        <a class="examples-btn" href="${searchUrl}" target="_blank" rel="noopener">
          <svg width="9" height="9" viewBox="0 0 9 9" fill="none"><circle cx="3.8" cy="3.8" r="3" stroke="currentColor" stroke-width="1.2"/><line x1="5.9" y1="5.9" x2="8.2" y2="8.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
          Examples
        </a>
        <div class="card-desc"><p>${item.description}</p></div>
      </div>
      <div class="card-body">
        <div class="card-text">
          <div class="card-name">${item.name}</div>
          <div class="card-origin">${item.origin}</div>
        </div>
        <button class="copy-btn" data-name="${item.name}">Copy</button>
      </div>${item.bestFor ? `<div class="card-bestfor">${item.bestFor.replace(/ (\S+)$/, '&nbsp;$1')}</div>` : ''}`;
    grid.appendChild(card);
  });

  section.appendChild(grid);
  app.appendChild(section);
});

const toast = document.getElementById('toast');
let toastTimer;

document.addEventListener('click', e => {
  const btn = e.target.closest('.copy-btn');
  if (!btn) return;
  const name = btn.dataset.name;
  const doCopy = () => {
    btn.textContent = '✓ Copied';
    btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 1800);
    toast.textContent = `"${name}" copied`;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
  };
  if (navigator.clipboard) {
    navigator.clipboard.writeText(name).then(doCopy).catch(() => fallbackCopy(name, doCopy));
  } else {
    fallbackCopy(name, doCopy);
  }
});

function fallbackCopy(text, cb) {
  const ta = document.createElement('textarea');
  ta.value = text;
  Object.assign(ta.style, { position:'fixed', opacity:'0', top:'0', left:'0' });
  document.body.appendChild(ta);
  ta.focus(); ta.select();
  try { document.execCommand('copy'); cb(); } catch(e) {}
  document.body.removeChild(ta);
}
</script>
