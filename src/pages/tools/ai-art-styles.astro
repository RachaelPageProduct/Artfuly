      { name: "Vector Illustration", origin: "Digital, 1980s–present", description: "Crisp scalable artwork built from mathematical paths — clean shapes, flat colour and precision used in logos, icons and editorial art.", img: "/images/ai-art-styles/vector-illustration.jpg", fallback: "linear-gradient(150deg,#ff6b35,#f7c59f,#efefef)" }
