      { name: "Aztec / Mesoamerican", origin: "Mesoamerica, Pre-Columbian", description: "Bold geometric and zoomorphic motifs, turquoise and terracotta palette, ritual symbolism and calendar patterns.", img: "https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Aztec_Sun_Stone_Replica_cropped.jpg/500px-Aztec_Sun_Stone_Replica_cropped.jpg", fallback: "linear-gradient(150deg,#3a1a00,#2a6a4a,#c87000)" },
