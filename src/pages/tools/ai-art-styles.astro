      { name: "Voxel Art", origin: "Digital, 1990s–present", description: "3D pixel art using cubes as building blocks — blocky, charming and reminiscent of Minecraft.", img: "/images/ai-art-styles/voxel-art.jpg", fallback: "linear-gradient(150deg,#2d6a4f,#52b788,#1565c0)" },
      { name: "Low Poly 3D", origin: "Digital, 2000s–present", description: "Geometric 3D models with visible flat-shaded polygons — clean, modern and slightly abstract.", img: "/images/ai-art-styles/low-poly-3d.jpg", fallback: "linear-gradient(150deg,#457b9d,#a8dadc,#f4a261)" },
      { name: "Isometric Illustration", origin: "Digital Design, 1980s–present", description: "Precise 45° axonometric 3D view — popular for app icons, maps, architecture diagrams and game environments.", img: "/images/ai-art-styles/isometric-illustration.jpg", fallback: "linear-gradient(150deg,#1d3557,#457b9d,#a8dadc)" },
      { name: "Flat Design", origin: "Digital, 2010s–present", description: "Minimal, shadow-free vector shapes with clean colours — the visual language of modern UI and icon design.", img: "/images/ai-art-styles/flat-design.jpg", fallback: "linear-gradient(150deg,#0096c7,#f4c700,#e63946)" },
